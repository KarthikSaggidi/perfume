# Production: PostgreSQL is required. Use your provider's pooled connection URL.
DATABASE_URL=
# Set require if your database provider requires explicit TLS (never reject verification).
DATABASE_SSL=
APP_URL=http://localhost:3001
# Separate browser hostnames are required: cookies are not isolated by port.
VELORA_STOREFRONT_URL=http://localhost:3001
VELORA_ADMIN_URL=http://127.0.0.1:3002
# Set by the launch scripts; manual Next deployments must choose one surface.
# VELORA_APP_SURFACE=storefront

# Twilio Verify (server-only; never use NEXT_PUBLIC_ for credentials).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_ALLOWED_COUNTRY_CODES=+91
# SMS delivery is restricted to localhost. Hosted/production requests are blocked.
VELORA_SMS_SCOPE=localhost
# Optional allowlist, populated by npm run sms:setup (E.164 numbers, comma separated).
OTP_TEST_NUMBERS=

# LOCAL DEVELOPMENT ONLY: logs one-time test codes to the private server terminal.
# This mode is disabled when NODE_ENV=production or on Vercel.
VELORA_SMS_MODE=development
# Local JSON storage is automatic in development. For self-hosted next start on
# a persistent disk only, explicitly enable this. Never use it on Vercel.
VELORA_LOCAL_STORAGE=false
# VELORA_DATA_DIR=/absolute/private/persistent/path
# Optional isolated development build directory (not a production setting).
# VELORA_DEV_DIST=.next-dev-admin-3002
